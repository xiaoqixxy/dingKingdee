<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.middle.ding.mapper.DingTenantMapper">

	<resultMap type="com.ruoyi.middle.ding.domain.DingTenant" id="DingTenantResult">
		<id     property="id"    column="id"    />
		<result property="dingCorpId"    column="ding_corp_id"    />
		<result property="corpName"    column="corp_name"    />
		<result property="contactUser"    column="contact_user"    />
		<result property="contactPhone"    column="contact_phone"    />
		<result property="status"    column="status"    />
		<result property="ext1"    column="ext1"    />
		<result property="ext2"    column="ext2"    />
		<result property="ext3"    column="ext3"    />
	</resultMap>
	
	<sql id="selectDingTenantVo">
        select id, ding_corp_id, corp_name, contact_user, contact_phone, status, ext1, ext2, ext3 
		from ding_tenant
    </sql>

	<select id="selectDingTenantList" parameterType="com.ruoyi.middle.ding.domain.DingTenant" resultMap="DingTenantResult">
	    <include refid="selectDingTenantVo"/>
		<where>
		    <if test="dingCorpId != null and dingCorpId != ''">
				AND ding_corp_id like concat('%', #{dingCorpId}, '%')
			</if>
			<if test="corpName != null and corpName != ''">
				AND corp_name like concat('%', #{corpName}, '%')
			</if>
			<if test="contactUser != null and contactUser != ''">
				AND contact_user like concat('%', #{contactUser}, '%')
			</if>
			<if test="status != null">
				AND status = #{status}
			</if>
	    </where>
	    order by id desc
	</select>
	
	<select id="selectDingTenantById" parameterType="Long" resultMap="DingTenantResult">
		<include refid="selectDingTenantVo"/>
		where id = #{id}
	</select>
	
	<select id="selectDingTenantByCorpId" parameterType="String" resultMap="DingTenantResult">
		<include refid="selectDingTenantVo"/>
		where ding_corp_id = #{dingCorpId}
	</select>
	
	<select id="checkDingCorpIdUnique" parameterType="String" resultMap="DingTenantResult">
		<include refid="selectDingTenantVo"/>
		where ding_corp_id = #{dingCorpId} limit 1
	</select>
	
	<delete id="deleteDingTenantById" parameterType="Long">
  		delete from ding_tenant where id = #{id}
  	</delete>
  	
  	<delete id="deleteDingTenantByIds" parameterType="Long">
  		delete from ding_tenant where id in
  		<foreach collection="array" item="id" open="(" separator="," close=")">
  			#{id}
        </foreach> 
  	</delete>

  	<update id="updateDingTenant" parameterType="com.ruoyi.middle.ding.domain.DingTenant">
  		update ding_tenant
  		<set>
  			<if test="dingCorpId != null and dingCorpId != ''">ding_corp_id = #{dingCorpId},</if>
  			<if test="corpName != null and corpName != ''">corp_name = #{corpName},</if>
  			<if test="contactUser != null">contact_user = #{contactUser},</if>
  			<if test="contactPhone != null">contact_phone = #{contactPhone},</if>
  			<if test="status != null">status = #{status},</if>
  			<if test="ext1 != null">ext1 = #{ext1},</if>
  			<if test="ext2 != null">ext2 = #{ext2},</if>
  			<if test="ext3 != null">ext3 = #{ext3},</if>
  		</set>
  		where id = #{id}
  	</update>
  	
  	<insert id="insertDingTenant" parameterType="com.ruoyi.middle.ding.domain.DingTenant" useGeneratedKeys="true" keyProperty="id">
  		insert into ding_tenant(
  			ding_corp_id,
  			corp_name,
  			contact_user,
  			contact_phone,
  			status
  			<if test="ext1 != null">,ext1</if>
  			<if test="ext2 != null">,ext2</if>
  			<if test="ext3 != null">,ext3</if>
  		)values(
  			#{dingCorpId},
  			#{corpName},
  			#{contactUser},
  			#{contactPhone},
  			#{status}
  			<if test="ext1 != null">,#{ext1}</if>
  			<if test="ext2 != null">,#{ext2}</if>
  			<if test="ext3 != null">,#{ext3}</if>
  		)
  	</insert>
  	
</mapper>
