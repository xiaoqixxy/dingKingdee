<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.middle.ding.mapper.DingSyncFormMapper">

	<resultMap type="com.ruoyi.middle.ding.domain.DingSyncForm" id="DingSyncFormResult">
		<id     property="id"    column="id"    />
		<result property="dingCorpId"    column="ding_corp_id"    />
		<result property="dingFormId"    column="ding_form_id"    />
		<result property="formName"    column="form_name"    />
		<result property="sourceSystem"    column="source_system"    />
		<result property="status"    column="status"    />
		<result property="ext1"    column="ext1"    />
		<result property="ext2"    column="ext2"    />
		<result property="ext3"    column="ext3"    />
	</resultMap>
	
	<sql id="selectDingSyncFormVo">
        select id, ding_corp_id, ding_form_id, form_name, source_system, status, ext1, ext2, ext3 
		from ding_sync_form
    </sql>

	<select id="selectDingSyncFormList" parameterType="com.ruoyi.middle.ding.domain.DingSyncForm" resultMap="DingSyncFormResult">
	    <include refid="selectDingSyncFormVo"/>
		<where>
		    <if test="dingCorpId != null and dingCorpId != ''">
				AND ding_corp_id like concat('%', #{dingCorpId}, '%')
			</if>
			<if test="dingFormId != null and dingFormId != ''">
				AND ding_form_id like concat('%', #{dingFormId}, '%')
			</if>
			<if test="formName != null and formName != ''">
				AND form_name like concat('%', #{formName}, '%')
			</if>
			<if test="sourceSystem != null and sourceSystem != ''">
				AND source_system = #{sourceSystem}
			</if>
			<if test="status != null">
				AND status = #{status}
			</if>
	    </where>
	    order by id desc
	</select>
	
	<select id="selectDingSyncFormById" parameterType="Long" resultMap="DingSyncFormResult">
		<include refid="selectDingSyncFormVo"/>
		where id = #{id}
	</select>
	
	<select id="selectDingSyncFormByCorpIdAndFormId" resultMap="DingSyncFormResult">
		<include refid="selectDingSyncFormVo"/>
		where ding_corp_id = #{dingCorpId} and ding_form_id = #{dingFormId}
	</select>
	
	<select id="selectDingSyncFormByCorpId" parameterType="String" resultMap="DingSyncFormResult">
		<include refid="selectDingSyncFormVo"/>
		where ding_corp_id = #{dingCorpId}
		order by id desc
	</select>
	
	<select id="countByCorpId" parameterType="String" resultType="int">
		select count(*) from ding_sync_form where ding_corp_id = #{dingCorpId} and status = 1
	</select>
	
	<delete id="deleteDingSyncFormById" parameterType="Long">
  		delete from ding_sync_form where id = #{id}
  	</delete>
  	
  	<delete id="deleteDingSyncFormByIds" parameterType="Long">
  		delete from ding_sync_form where id in
  		<foreach collection="array" item="id" open="(" separator="," close=")">
  			#{id}
        </foreach> 
  	</delete>

  	<update id="updateDingSyncForm" parameterType="com.ruoyi.middle.ding.domain.DingSyncForm">
  		update ding_sync_form
  		<set>
  			<if test="dingCorpId != null and dingCorpId != ''">ding_corp_id = #{dingCorpId},</if>
  			<if test="dingFormId != null and dingFormId != ''">ding_form_id = #{dingFormId},</if>
  			<if test="formName != null and formName != ''">form_name = #{formName},</if>
  			<if test="sourceSystem != null">source_system = #{sourceSystem},</if>
  			<if test="status != null">status = #{status},</if>
  			<if test="ext1 != null">ext1 = #{ext1},</if>
  			<if test="ext2 != null">ext2 = #{ext2},</if>
  			<if test="ext3 != null">ext3 = #{ext3},</if>
  		</set>
  		where id = #{id}
  	</update>
  	
  	<insert id="insertDingSyncForm" parameterType="com.ruoyi.middle.ding.domain.DingSyncForm" useGeneratedKeys="true" keyProperty="id">
  		insert into ding_sync_form(
  			ding_corp_id,
  			ding_form_id,
  			form_name,
  			source_system,
  			status
  			<if test="ext1 != null">,ext1</if>
  			<if test="ext2 != null">,ext2</if>
  			<if test="ext3 != null">,ext3</if>
  		)values(
  			#{dingCorpId},
  			#{dingFormId},
  			#{formName},
  			#{sourceSystem},
  			#{status}
  			<if test="ext1 != null">,#{ext1}</if>
  			<if test="ext2 != null">,#{ext2}</if>
  			<if test="ext3 != null">,#{ext3}</if>
  		)
  	</insert>
  	
</mapper>
