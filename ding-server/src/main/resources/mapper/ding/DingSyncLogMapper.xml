<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dj.middle.ding.mapper.DingSyncLogMapper">

    <!-- DingSyncLogResult：数据库列到业务对象属性的映射；字段映射与条件参数需与对应Mapper保持一致。 -->
    <resultMap type="com.dj.middle.ding.domain.DingSyncLog" id="DingSyncLogResult">
		<id     property="id"    column="id"    />
		<result property="dingCorpId"    column="ding_corp_id"    />
		<result property="dingFormId"    column="ding_form_id"    />
		<result property="syncCount"    column="sync_count"    />
		<result property="status"    column="status"    />
		<result property="errorMsg"    column="error_msg"    />
		<result property="ext1"    column="ext1"    />
		<result property="ext2"    column="ext2"    />
		<result property="ext3"    column="ext3"    />
	<result property="createTime" column="create_time" />
	    <result property="corpName" column="corp_name" />
    </resultMap>
	
	<!-- selectDingSyncLogVo：复用的字段列表或查询片段；字段映射与条件参数需与对应Mapper保持一致。 -->
	<sql id="selectDingSyncLogVo">
        select corp_name, id, ding_corp_id, ding_form_id, sync_count, status, error_msg, ext1, ext2, ext3, create_time
		from (select source.*, tenant.corp_name from ding_sync_log source left join ding_tenant tenant on tenant.ding_corp_id=source.ding_corp_id) enriched
    </sql>

    <!-- selectDingSyncLogList：按约定参数查询业务记录；字段映射与条件参数需与对应Mapper保持一致。 -->
    <select id="selectDingSyncLogList" parameterType="com.dj.middle.ding.domain.DingSyncLog" resultMap="DingSyncLogResult">
	    <include refid="selectDingSyncLogVo"/>
		<where>
		    <if test="dingCorpId != null and dingCorpId != ''">
				AND ding_corp_id = #{dingCorpId}
			</if>
			<if test="dingFormId != null and dingFormId != ''">
				AND ding_form_id = #{dingFormId}
			</if>
			<if test="status != null">
				AND status = #{status}
			</if>
			<if test="params.beginTime != null and params.beginTime != ''">
				and create_time &gt;= CAST(#{params.beginTime} AS DATE)
			</if>
			<if test="params.endTime != null and params.endTime != ''">
				and create_time &lt; DATE_ADD(CAST(#{params.endTime} AS DATE), INTERVAL 1 DAY)
			</if>
	    </where>
	    order by id desc
	</select>
	
	<!-- selectDingSyncLogById：按约定参数查询业务记录；字段映射与条件参数需与对应Mapper保持一致。 -->
	<select id="selectDingSyncLogById" parameterType="Long" resultMap="DingSyncLogResult">
		<include refid="selectDingSyncLogVo"/>
		where id = #{id}
	</select>
	
	<!-- selectDingSyncLogByCorpId：按约定参数查询业务记录；字段映射与条件参数需与对应Mapper保持一致。 -->
	<select id="selectDingSyncLogByCorpId" parameterType="String" resultMap="DingSyncLogResult">
		<include refid="selectDingSyncLogVo"/>
		where ding_corp_id = #{dingCorpId}
		order by id desc
	</select>
	
	<!-- sumSyncCountByCorpIdAndMonth：按约定参数查询业务记录；字段映射与条件参数需与对应Mapper保持一致。 -->
	<select id="sumSyncCountByCorpIdAndMonth" resultType="int">
		select ifnull(sum(sync_count), 0) from ding_sync_log 
		where ding_corp_id = #{dingCorpId} 
		and status = 1 
		and create_time &gt;= STR_TO_DATE(CONCAT(#{month}, '01'), '%Y%m%d')
        and create_time &lt; DATE_ADD(STR_TO_DATE(CONCAT(#{month}, '01'), '%Y%m%d'), INTERVAL 1 MONTH)
	</select>
	
	<!-- deleteDingSyncLogById：删除指定范围的业务记录；字段映射与条件参数需与对应Mapper保持一致。 -->
	<delete id="deleteDingSyncLogById" parameterType="Long">
  		delete from ding_sync_log where id = #{id}
  	</delete>
  	
  	<!-- deleteDingSyncLogByIds：删除指定范围的业务记录；字段映射与条件参数需与对应Mapper保持一致。 -->
  	<delete id="deleteDingSyncLogByIds" parameterType="Long">
  		delete from ding_sync_log where id in
  		<foreach collection="array" item="id" open="(" separator="," close=")">
  			#{id}
        </foreach> 
  	</delete>

    <!-- insertDingSyncLog：保存新增业务记录；字段映射与条件参数需与对应Mapper保持一致。 -->
    <insert id="insertDingSyncLog" parameterType="com.dj.middle.ding.domain.DingSyncLog" useGeneratedKeys="true" keyProperty="id">
  		insert into ding_sync_log(
            create_time,
  			ding_corp_id,
  			ding_form_id,
  			sync_count,
  			status,
  			error_msg
  			<if test="ext1 != null">,ext1</if>
  			<if test="ext2 != null">,ext2</if>
  			<if test="ext3 != null">,ext3</if>
  		)values(
            COALESCE(#{createTime}, CURRENT_TIMESTAMP(3)),
  			#{dingCorpId},
  			#{dingFormId},
  			#{syncCount},
  			#{status},
  			#{errorMsg}
  			<if test="ext1 != null">,#{ext1}</if>
  			<if test="ext2 != null">,#{ext2}</if>
  			<if test="ext3 != null">,#{ext3}</if>
  		)
  	</insert>
  	
</mapper>
